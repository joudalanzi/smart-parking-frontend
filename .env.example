# اختياري — عنوان الباك الكامل عند النشر أو تجاوز الافتراضي المحلي
# VITE_API_URL=https://api.example.com
#
# على localhost يُستعمل تلقائياً نفس المضيف والمنفذ 4000 (مثل http://localhost:4000)
# لتجاوز ذلك بالكامل أو منفذ مختلف:
# VITE_LOCAL_BACKEND_ORIGIN=http://127.0.0.1:5000
# VITE_LOCAL_BACKEND_PORT=5000
#
VITE_API_URL=
